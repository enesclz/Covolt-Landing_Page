<style>
  .howit-card-enter {
    opacity: 0;
    transform: translateY(16px) scale(0.98);
  }
  .howit-card-enter-active {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  /* Her adım ekran yüksekliği kadar alan kaplasın ki scroll sırasında kartlar sırayla değişsin */
  .number-spin-enter {
    transform: rotateX(90deg);
    transition: transform 120ms ease;
  }
  .number-spin-enter-active {
    transform: rotateX(0deg);
  }
  .indicator-dot.is-active {
    background: rgba(25,18,101,0.06);
    box-shadow: 0 0 0 2px rgba(25,18,101,0.12) inset;
  }
  .progress-ring { transition: stroke-dashoffset 180ms ease; }
  /* Bölüm pin efekti: toplam yükseklik 4 adım için uzun, içerik sticky */
  .howit-wrapper {
    height: 400vh;
  }
  .howit-sticky {
    position: sticky;
    top: 6rem;
    height: calc(100vh - 6rem);
    display: flex;
    align-items: stretch;
  }
  /* Çok satırlı açıklamayı satır sonlarına göre kır */
  /* Liste biçiminde gösterilecek; işaret boyutu büyütüldü */
  #howit-card-desc { white-space: normal; }
  #howit-card-desc { font-size: 1rem; }
  #howit-card-desc { list-style-type: disc; }
  #howit-card-desc { display: block; text-align: left; }
  #howit-card-desc li { margin-top: 0.5rem; }
  /* Varsayılan marker görünümü */
  #howit-card-desc li::marker { font-size: 1em; color: currentColor; }

  /* Sol sütundaki numara ve başlıklar için #191265 efektleri */
  .howit-number {
    color: #191265;
    box-shadow: 0 6px 18px rgba(25,18,101,0.12);
    background: radial-gradient(120% 120% at 30% 20%, rgba(25,18,101,0.06), rgba(25,18,101,0) 60%), #ffffff;
  }
  .howit-step h3 {
    color: #191265;
    text-shadow: 0 1px 0 rgba(25,18,101,0.06);
  }

  /* Sağdaki kart için uyumlu renk ve efektler */
  .howit-card-badge {
    color: #191265;
    box-shadow: 0 8px 22px rgba(25,18,101,0.12);
    background: radial-gradient(120% 120% at 30% 20%, rgba(25,18,101,0.06), rgba(25,18,101,0) 60%), #ffffff;
  }
  #howit-card-step {
    color: #191265;
  }
  #howit-card-title {
    color: #191265;
    text-shadow: 0 1px 0 rgba(25,18,101,0.06);
  }
</style>

<script>
  function initHowItWorks() {
    const steps = Array.from(document.querySelectorAll('.howit-step'));
    const card = document.querySelector('.howit-card');
    const stepEl = document.getElementById('howit-card-step');
    const titleEl = document.getElementById('howit-card-title');
    const descEl = document.getElementById('howit-card-desc');
    const progress = null;
    const indicatorDots = Array.from(document.querySelectorAll('.indicator-dot'));
    const rings = Array.from(document.querySelectorAll('.progress-ring'));

    if (!steps.length || !card || !stepEl || !titleEl || !descEl) return;

    // Pinli bölümde scroll ilerleyişini yüzdelik olarak kullanıp aktif adımı hesapla
    const wrapper = document.querySelector('.howit-wrapper');
    let lastActiveIndex = -1;
    const pickStepByProgress = (direction = 'down') => {
      const rect = wrapper.getBoundingClientRect();
      const total = rect.height - window.innerHeight; // pinli alanda scroll edilebilir mesafe
      const progressed = Math.min(Math.max(-rect.top, 0), total);
      // Geçişi biraz daha kısa mesafede tetiklemek için hız çarpanı
      const SPEED = 1.75;
      const ratio = total > 0 ? Math.min(1, (progressed / total) * SPEED) : 0;
      let index = Math.min(steps.length - 1, Math.max(0, Math.round(ratio * (steps.length - 1))));
      // Yukarı çıkarken ara adımları göstermeden ilk adıma atla
      if (direction === 'up') index = 0;
      if (index !== lastActiveIndex) {
        lastActiveIndex = index;
        const el = steps[index];
        // Yukarı çıkarken animasyonu kapat
        setCard(el, direction !== 'up');
        steps.forEach((s, idx) => s.classList.toggle('opacity-60', idx !== index));
        if (indicatorDots.length) {
          indicatorDots.forEach((d) => d.classList.toggle('is-active', parseInt(d.getAttribute('data-step')) - 1 === index));
        }
        if (rings.length) {
          rings.forEach((r, i) => {
            const length = 132; // stroke-dasharray
            r.style.strokeDashoffset = i === index ? '0' : String(length);
          });
        }
      }
    };

    const setCard = (el, animate = true) => {
      const num = el.getAttribute('data-step');
      const title = el.getAttribute('data-title');
      const desc = el.getAttribute('data-desc');

      if (!animate) {
        // Animasyonsuz geçiş
        stepEl.textContent = num;
        titleEl.textContent = title;
        const lines = (desc || '')
          .split(/\r?\n|&#10;|\u000A/g)
          .map((s) => s.replace(/^\s*[.•\-]\s*/, '').trim())
          .filter(Boolean);
        descEl.innerHTML = lines.map((line) => `<li>${line}</li>`).join('');
        return;
      }

      // enter animation
      card.classList.remove('howit-card-enter-active');
      card.classList.add('howit-card-enter');

      requestAnimationFrame(() => {
        // number spin animation
        stepEl.classList.remove('number-spin-enter-active');
        stepEl.classList.add('number-spin-enter');
        stepEl.textContent = num;
        titleEl.textContent = title;
        // Açıklamayı satırlara böl ve liste öğeleri olarak yerleştir
        const lines = (desc || '')
          .split(/\r?\n|&#10;|\u000A/g)
          .map((s) => s.replace(/^\s*[.•\-]\s*/, '').trim())
          .filter(Boolean);
        descEl.innerHTML = lines.map((line) => `<li>${line}</li>`).join('');

        // allow style flush then animate
        requestAnimationFrame(() => {
          card.classList.remove('howit-card-enter');
          card.classList.add('howit-card-enter-active');
          stepEl.classList.remove('number-spin-enter');
          stepEl.classList.add('number-spin-enter-active');
        });
      });
    };

    // Scroll ve resize'da sürekli güncelle
    let ticking = false;
    let lastScrollY = window.scrollY;
    const onScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const currentY = window.scrollY;
          const direction = currentY < lastScrollY ? 'up' : 'down';
          lastScrollY = currentY;
          pickStepByProgress(direction);
          ticking = false;
        });
        ticking = true;
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    // İlk yüklemede doğru adımı seç
    pickStepByProgress('down');
  }

  document.addEventListener('DOMContentLoaded', initHowItWorks);
</script>
