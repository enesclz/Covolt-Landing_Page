</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const faqQuestions = document.querySelectorAll('.faq-question');
    const faqAnswers = document.querySelectorAll('.faq-answer');
    const faqArrows = document.querySelectorAll('.faq-arrow');

    faqQuestions.forEach((question, index) => {
      question.addEventListener('click', () => {
        const answer = question.nextElementSibling;
        const arrow = question.querySelector('.faq-arrow');
        const isOpen = answer.classList.contains('open');

        // Close all other answers
        faqAnswers.forEach((ans, i) => {
          if (i !== index) {
            ans.classList.remove('open');
            ans.style.maxHeight = '0px';
            faqArrows[i].style.transform = 'rotate(0deg)';
          }
        });

        // Toggle current answer
        if (isOpen) {
          answer.classList.remove('open');
          answer.style.maxHeight = '0px';
          arrow.style.transform = 'rotate(0deg)';
        } else {
          answer.classList.add('open');
          answer.style.maxHeight = answer.scrollHeight + 'px';
          arrow.style.transform = 'rotate(180deg)';
        }
      });
    });
  });
</script>

<style>
  .faq-item {
    transition: all 0.3s ease;
  }

  .faq-item:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
  }

  .faq-question {
    cursor: pointer;
    outline: none;
  }

  .faq-question:focus {
    outline: 2px solid #191265;
    outline-offset: 2px;
  }

  .faq-answer {
    /* Çizgi tamamen kaldırıldı */
  }

  /* Açılan FAQ'larda lacivert çizgi göster */
  /* Çizgi tamamen kaldırıldı */

  .faq-arrow {
    transition: transform 0.3s ease;
  }

  .covolt-primary {
    color: #191265;
  }

  .covolt-primary-bg {
    background-color: #191265;
  }

  /* Smooth scrolling for the page */
  html {
    scroll-behavior: smooth;
  }

  /* Custom scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
  }

  ::-webkit-scrollbar-track {
    background: #f1f5f9;
  }

  ::-webkit-scrollbar-thumb {
    background: #191265;
    border-radius: 4px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: #140f4f;
  }
</style>
