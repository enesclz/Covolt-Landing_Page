        <div class="faq-item bg-white rounded-2xl shadow-lg border border-[#191265] overflow-hidden">
          <button class="faq-question w-full p-6 text-left hover:bg-gray-50 transition-colors duration-200" data-faq="6">
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-4">
                <div class="w-12 h-12 covolt-primary-bg rounded-2xl flex items-center justify-center text-white font-bold text-lg shadow-sm">
                  6
                </div>
