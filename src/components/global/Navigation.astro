---
import { Image } from "astro:assets";
import covoltLogo from "../../assets/images/covolt-logo.png";
---

<header
  class="border-b border-black/5 sticky top-0 z-50 backdrop-blur-2xl">
  <div class="w-full mx-auto px-8 max-w-7xl lg:px-16">
    <div
      class="relative flex flex-row w-full py-5 mx-auto items-center justify-between lg:px-6">
      <div class="flex flex-row items-center">
        <a href="/" class="text-black inline-flex items-center">
          <Image width={120} src={covoltLogo} alt="Covolt Logo" />
        </a>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="https://app.covolt.com.tr/auth/v1/login"
          class="flex items-center justify-center transition-all duration-200 focus:ring-2 focus:outline-none text-base-600 bg-white hover:text-accent-600 ring-1 ring-base-200 focus:bg-accent-100 h-9 px-4 py-2 text-sm font-medium rounded-md hover:bg-accent-50">
          Giriş Yap
        </a>
        <a
          href="https://app.covolt.com.tr/auth/v1/register"
          class="flex items-center justify-center transition-all duration-200 ring-1 focus:ring-2 ring-accent-700 focus:outline-none text-white bg-accent-600 hover:bg-accent-700 focus:ring-base-500/50 h-9 px-4 py-2 text-sm font-medium rounded-md">
          Kayıt Ol
        </a>
      </div>

    </div>
  </div>
</header>
