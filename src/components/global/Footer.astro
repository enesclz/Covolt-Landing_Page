---
import OptimizedImage from "../../layouts/utilities/OptimizedImage.astro";
import { Image } from "astro:assets";
import covoltLogo from "../../assets/images/covolt-logo.png";

const sections = [];
---

<footer
  id="dynamic-footer"
  class="bg-gradient-to-br from-accent-50 via-white to-accent-100 border-base-200 mt-20 transition-all duration-300 ease-out">
  <div class="px-6 md:px-12 lg:px-24 py-20 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-16">
      <div class="md:col-span-1">
        <a href="/" class="inline-flex items-center gap-3">
          <Image width={120} src={covoltLogo} alt="Covolt Logo" />
        </a>
        <p class="mt-4 text-sm text-gray-600">
          İşletmelerin elektrik tüketimini kontrol altına almasını sağlayan, 
          maliyetleri düşüren ve sürdürülebilirliği destekleyen enerji yönetimi platformu.
        </p>
        <div class="mt-6 flex space-x-4">
          <a href="https://www.linkedin.com/company/covolt-tech/?viewAsMember=true" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-accent-600 transition">
            <span class="sr-only">LinkedIn</span>
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.338 16.338H13.67V12.16c0-.995-.017-2.277-1.387-2.277-1.39 0-1.601 1.086-1.601 2.207v4.248H8.014v-8.59h2.559v1.174h.037c.356-.675 1.227-1.387 2.526-1.387 2.703 0 3.203 1.778 3.203 4.092v4.711zM5.005 6.575a1.548 1.548 0 11-.003-3.096 1.548 1.548 0 01.003 3.096zm-1.337 9.763H6.34v-8.59H3.667v8.59zM17.668 1H2.328C1.595 1 1 1.581 1 2.298v15.403C1 18.418 1.595 19 2.328 19h15.34c.734 0 1.332-.582 1.332-1.299V2.298C19 1.581 18.402 1 17.668 1z" clip-rule="evenodd"></path>
            </svg>
          </a>
          <a href="https://www.instagram.com/covolt.tech?igsh=ZDdxcDdpb2xpM2Rs" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-accent-600 transition">
            <span class="sr-only">Instagram</span>
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
        </div>
      </div>

      <div class="md:col-span-2">
        <h3 class="text-lg font-semibold text-black mb-2">
          Enerji Yönetimi Güncellemeleri
        </h3>
        <p class="text-sm text-gray-600 mb-4">
          Enerji sektöründeki yenilikler, OSOS güncellemeleri ve maliyet optimizasyon 
          ipuçları için bültenimize katılın.
        </p>
        <form class="flex flex-col sm:flex-row items-center gap-3 w-full">
          <input
            type="email"
            placeholder="E-posta adresiniz"
            class="w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-2 focus:ring-accent-500 focus:outline-none"
          />
          <button
            type="submit"
            class="px-6 py-2 w-full md:w-auto rounded-md bg-accent-600 text-white hover:bg-accent-700 transition">
            Abone Ol
          </button>
        </form>
      </div>
    </div>

    <div
      class="pt-12 mt-12 border-t border-base-200 flex flex-col md:flex-row justify-between items-center text-xs text-gray-500">
      <p>
        &copy; {new Date().getFullYear()} Covolt. Tüm hakları saklıdır.
      </p>
      <p class="mt-2 md:mt-0">Türkiye'nin enerji yönetimi platformu</p>
    </div>
  </div>
</footer>

<script>
  // Footer için dinamik border radius efekti
  function updateFooterRadius() {
    const footer = document.getElementById('dynamic-footer');
    if (!footer) return;

    const scrollY = window.scrollY;
    const windowHeight = window.innerHeight;
    const documentHeight = document.documentElement.scrollHeight;
    
    // Footer'ın viewport'a ne kadar yakın olduğunu hesapla
    const footerTop = footer.offsetTop;
    const distanceToFooter = footerTop - scrollY - windowHeight;
    
    // Scroll threshold'u (piksel cinsinden) - bu değeri ayarlayabilirsiniz
    const scrollThreshold = 800;
    
    // Border radius hesaplama
    let borderRadius = 0;
    
    if (distanceToFooter <= scrollThreshold && distanceToFooter > 0) {
      // Scroll threshold içindeyken radius artır
      const progress = 1 - (distanceToFooter / scrollThreshold);
      borderRadius = Math.min(progress * 32, 32); // Maximum 32px radius
    } else if (distanceToFooter <= 0) {
      // Footer görünür olduğunda maksimum radius
      borderRadius = 32;
    }
    
    // Border radius'u uygula
    footer.style.borderRadius = `${borderRadius}px ${borderRadius}px 0 0`;
  }

  // Scroll event listener'ı ekle
  window.addEventListener('scroll', updateFooterRadius);
  
  // Sayfa yüklendiğinde de çalıştır
  window.addEventListener('load', updateFooterRadius);
  
  // Resize event'inde de güncelle
  window.addEventListener('resize', updateFooterRadius);
</script>
